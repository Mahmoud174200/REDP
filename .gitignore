# ───────────────────────────────────────────────────
# REDP Git Ignore Patterns
# ───────────────────────────────────────────────────

# Dependency Directories
node_modules/
vendor/
packages/

# Environment Configurations
.env
.env.backup
.env.production
*.env

# Build & Compilation Outputs
dist/
build/
out/
.next/
*.tgz
*.zip
*.tar.gz

# Logs & System Files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db

# IDE & Editor Specifics
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# Testing & Coverage
coverage/
.nyc_output

# Laravel specific files
backend/vendor/
backend/bootstrap/cache/
backend/storage/*.key
backend/storage/framework/cache/data/
backend/storage/framework/sessions/
backend/storage/framework/views/
backend/storage/logs/*.log
backend/.env

# Flutter specific files
mobile/.dart_tool/
mobile/.packages
mobile/build/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/ios/Pods/
mobile/android/.gradle/
mobile/*.ipr
mobile/*.iws
mobile/*.fdb_rocket_state

# Application specific assets
pdf_pages/

# Local demo database + heavy local model assets
backend/database/*.sqlite
web/public/*.fbx
web/public/*.obj
