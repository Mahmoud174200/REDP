# ═══════════════════════════════════════════════════
# REDP — System Environment Configuration Template
# Real Estate Digital Platform (Pivoted Stack: Laravel, React, Flutter, MySQL)
# ═══════════════════════════════════════════════════

# ───────────────────────────────────────────────────
# Laravel Backend Environment
# ───────────────────────────────────────────────────
APP_NAME=REDP_Backend
APP_ENV=local
APP_KEY=base64:uq6Gvj1J3/u7pE6bWp5TfG5Mv8wE4zK9t4N3n1L4j3Y=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ───────────────────────────────────────────────────
# Database Configuration (MySQL)
# ───────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=redp_db
DB_USERNAME=root
DB_PASSWORD=

# ───────────────────────────────────────────────────
# Cache & Session & Queue Configuration (Redis)
# ───────────────────────────────────────────────────
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ───────────────────────────────────────────────────
# Laravel Sanctum / Token Expiry
# ───────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
TOKEN_EXPIRY_MINUTES=1440

# ───────────────────────────────────────────────────
# S3 File Storage (AWS)
# ───────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=redp-document-vault
AWS_USE_PATH_STYLE_ENDPOINT=false

# ───────────────────────────────────────────────────
# Notification Services (FCM, WhatsApp, Twilio, SendGrid)
# ───────────────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=storage/app/firebase/service-account.json
WHATSAPP_API_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
TWILIO_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
SENDGRID_API_KEY=your_sendgrid_api_key
MAIL_FROM_ADDRESS="no-reply@redp.com"
MAIL_FROM_NAME="REDP Platform"

# ───────────────────────────────────────────────────
# AI Assistant / Chatbot (Google Gemini)
# ───────────────────────────────────────────────────
# Provider for the analytics AI features (lead scoring, forecasts): 'gemini' or 'local'
AI_PROVIDER=gemini
# Paste your Google Gemini API key here (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key
# Any CURRENT Gemini model that supports function calling (gemini-2.5-flash, gemini-2.5-pro, gemini-flash-latest)
# Note: gemini-2.0-flash / gemini-1.5-flash are deprecated and return 404.
GEMINI_MODEL=gemini-2.5-flash

# ───────────────────────────────────────────────────
# React Web App Configuration (.env for /web)
# ───────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_NAME="REDP Portal"
VITE_ENABLE_MOCK_API=false
